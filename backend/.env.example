# Sustainability & SDG Reporting Hub — Backend
# Copy this file to .env and adjust values for your environment.

# Project
PROJECT_NAME="Sustainability & SDG Reporting Hub"
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL (used when DATABASE_URL is not set)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=sustainability_hub
POSTGRES_USER=hub_user
POSTGRES_PASSWORD=change_me_secure_password

# Optional: override with full URL (takes precedence if set)
# DATABASE_URL=postgresql+asyncpg://hub_user:change_me_secure_password@db:5432/sustainability_hub

# Auth / JWT (Step 3) — CHANGE IN PRODUCTION
SECRET_KEY=change-me-in-production-use-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# First admin bootstrap (for seed_admin.py)
FIRST_ADMIN_NAME=System Admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# File upload (Step 9 — evidence, local dev)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EVIDENCE_EXTENSIONS=pdf,xlsx,xls,csv,jpg,jpeg,png,doc,docx

# CORS (deployment): comma-separated allowed origins, e.g. https://your-app.vercel.app
# Leave empty for localhost-only (dev).
# CORS_ORIGINS=

# LLM / AI (Step 11 — report section generation)
# Set OPENAI_API_KEY to enable "Generate with AI" in Report Sections. Get a key from https://platform.openai.com/
# Leave empty to disable AI generation (the button will show a configuration message).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: LLM_BASE_URL=https://api.openai.com/v1
